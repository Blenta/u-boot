/dts-v1/;
#include "skeleton.dtsi"
#include "exynos4412.dtsi"

/ {
	model = "TOPEET iTop 4412 Elite board based on Exynos4412";
	compatible = "topeet,itop4412-elite", "samsung,exynos4412";

	chosen {
		bootargs ="console=ttySAC2,115200n8 androidboot.console=ttySAC2 ctp=1 skipcali=y";
	};

	config {
		bootcmd = "mmc rescan; mmc dev ${mmcbootdev}; \
			mmc read ${kernelloadaddr} ${kernelboff} ${kernelbsize}; \
			mmc read ${ramdiskloadaddr} ${ramdiskboff} ${ramdiskbsize}; \
			setenv initrd_high 0xffffffff; \
			bootz ${kernelloadaddr} ${ramdiskloadaddr}";
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x40000000 0x40000000>;
	};
	
	aliases {
		mmc0 = &mshc_0;
		mmc2 = &sdhci2;
		serial0 = "/serial@13820000";
		console = "/serial@13820000";
	};

	emmc_pwrseq: pwrseq {
		compatible = "mmc-pwrseq-emmc";
		reset-gpios = <&gpk1 2 0>;
	};

};

&mshc_0 {
	div = <0x3>;
	index = <4>;
	samsung,dw-mshc-sdr-timing = <2 3>;
	bus-width = <8>;
	cap-mmc-highspeed;
	non-removable;
	mmc-pwrseq = <&emmc_pwrseq>;
	broken-cd;
	card-detect-delay = <200>;
	status = "okay";
};

&sdhci2 {
	bus-width = <4>;
	samsung,timing = <1 2 3>;
	cd-gpios = <&gpx0 7 0>;
	cap-sd-highspeed;
	cd-inverted;
	status = "okay";
};
