/dts-v1/;
#include "skeleton.dtsi"
#include "exynos4412.dtsi"

/ {
	model = "Tiny4412 board based on Exynos4412";
	compatible = "samsung,tiny4412", "samsung,exynos4412";

	chosen {
		bootargs ="console=ttySAC0,115200n8 androidboot.console=ttySAC0 ctp=1 skipcali=y vmalloc=384m ethmac=1C:6F:65:34:51:7E androidboot.selinux=permissive";
	};

	config {
		bootcmd = "mmc rescan; mmc dev ${mmcbootdev}; \ 
			mmc read ${kernelloadaddr} ${kernelboff} ${kernelbsize}; \
			mmc read ${ramdiskloadaddr} ${ramdiskboff} ${ramdiskbsize}; \
			bootz ${kernelloadaddr} ${ramdiskloadaddr}";
	};

	aliases {
		mmc0 = &sdhci0;
		mmc2 = &sdhci2;
		serial0 = "/serial@13800000";
		console = "/serial@13800000";
	};
};


&sdhci0 {
	bus-width = <4>;
	samsung,timing = <1 2 3>;
	cap-mmc-highspeed = "true";
	non-removable = "true";
	status = "okay";
};


&sdhci2 {
	bus-width = <4>;
	samsung,timing = <1 2 3>;
	cd-gpios = <&gpk2 2 0>;
	cap-sd-highspeed = "true";
	cd-inverted = "true";
	status = "okay";
};
