/dts-v1/;
#include "skeleton.dtsi"
#include "exynos4412.dtsi"

/ {
	model = "Tiny4412 board based on Exynos4412";
	compatible = "samsung,tiny4412", "samsung,exynos4412";

	chosen {
		bootargs ="root=/dev/mmcblk0p1 rootfstype=ext4 console=ttySAC0,115200 init=/linuxrc ctp=2 skipcali=y earlyprintk";
	};

	config {
		bootcmd = "mmc rescan; mmc dev ${mmcbootdev}; mmc read ${loadaddr} ${kernelboff} ${kernelbsize}; bootz ${loadaddr} ";
	};

	aliases {
		mmc0 = &sdhci0;
		mmc2 = &sdhci2;
		serial0 = "/serial@13800000";
		console = "/serial@13800000";
	};
};


&sdhci0 {
	bus-width = <4>;
	samsung,timing = <1 2 3>;
	cap-mmc-highspeed = "true";
	non-removable = "true";
	status = "okay";
};


&sdhci2 {
	bus-width = <4>;
	samsung,timing = <1 2 3>;
	cd-gpios = <&gpk2 2 0>;
	cap-sd-highspeed = "true";
	cd-inverted = "true";
	status = "okay";
};
